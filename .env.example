# PostgreSQL (used by the `db` service in docker-compose.yml)
POSTGRES_USER=guardian
POSTGRES_PASSWORD=guardian
POSTGRES_DB=guardian

# Backend database URL — use host `db` inside Docker Compose.
# For a backend process running on the host against the published DB port, use localhost instead.
DATABASE_URL=postgresql+psycopg://guardian:guardian@db:5432/guardian

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
TOOL_TIMEOUT_SECONDS=30
MAX_FIX_ATTEMPTS=1

# AI provider: "mock" (default, no key) or "openrouter"
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Guardian AI

# Frontend (browser → host-published backend)
VITE_API_BASE_URL=http://localhost:8000/api
